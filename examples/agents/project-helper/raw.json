{
  "default_agent": "project",
  "models": {
    "local": {
      "provider": "ollama",
      "method": "openai-chat-completions",
      "model_id": "YOUR_INSTALLED_MODEL",
      "base_url": "http://127.0.0.1:11434/v1"
    }
  },
  "agents": {
    "project": {
      "model": "local",
      "system_prompt_file": "prompt.md",
      "tools": {
        "use": [
          "builtin/read_file",
          "builtin/bash",
          "agent/project_note",
          "builtin/list_skills",
          "builtin/load_skill",
          "builtin/list_vars",
          "builtin/read_var"
        ],
        "rules": [
          {
            "match": "builtin/bash",
            "effect": "ask",
            "when": {
              "any": "commands[*].command",
              "regex": "(^|[;&|()\\n])\\s*(sudo\\s+)?(/usr/bin/|/bin/)?rm(\\s|$)"
            }
          }
        ]
      },
      "skills": {
        "use": [
          "agent/project"
        ]
      },
      "vars": [
        "project_info"
      ]
    }
  },
  "vars": {
    "project_info": {
      "description": "Portable project helper settings",
      "access": "read",
      "source": {
        "kind": "file",
        "path": "project-info.json",
        "format": "json"
      }
    }
  }
}
