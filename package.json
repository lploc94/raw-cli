{
  "name": "@tlelabs/raw",
  "version": "0.1.1",
  "description": "A local coding agent for models with limited context: composable tools, skills, hooks and agents, with a terminal REPL, browser dashboard and ACP.",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "llm",
    "acp",
    "mcp",
    "terminal"
  ],
  "homepage": "https://raw.tlelabs.com",
  "bugs": {
    "url": "https://github.com/lploc94/raw-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lploc94/raw-cli.git"
  },
  "license": "MIT",
  "author": "Thorn Lee <lploc94@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "raw": "./dist/raw.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples/tools",
    "examples/hooks",
    "examples/skills",
    "examples/agents",
    "examples/packages",
    "docs/skill-authoring.md",
    "docs/hooks.md",
    "docs/configuration.md",
    "docs/tools.md",
    "docs/terminal-output.md",
    "README.md",
    "docs/vars.md",
    "docs/packages.md",
    "schemas/raw-package.schema.json",
    "examples/providers",
    "docs/dashboard.md",
    "docs/dashboard-api.md",
    "docs/dashboard",
    "docs/cli.md",
    "docs/architecture.md",
    "docs/skills.md",
    "docs/management.md",
    "docs/sessions.md",
    "docs/context.md",
    "docs/tool-effects.md",
    "docs/processes.md",
    "docs/diagrams.md",
    "docs/panels-design.md",
    "docs/evidence",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run build && node scripts/test.mjs",
    "test:phase": "node scripts/test-phase.mjs",
    "test:overhead": "node --import tsx scripts/overhead.mjs",
    "test:package": "npm run build && node --import tsx --test tests/package.test.ts tests/package-agent.test.ts tests/package-sharing-installed.test.ts tests/dashboard-installed.test.ts",
    "build": "tsup && tsup --config tsup.tools.config.ts && node scripts/copy-tool-manifests.mjs && node scripts/build-tool-examples.mjs && node scripts/copy-bundled-skills.mjs && vite build",
    "check": "npm run typecheck && npm test",
    "test:web": "playwright test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@anthropic-ai/sdk": "0.128.0",
    "@google/genai": "2.24.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@zip.js/zip.js": "2.18.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsonc-parser": "3.3.1",
    "lowlight": "3.3.0",
    "marked": "18.0.14",
    "openai": "7.23.0",
    "re2js": "2.8.6",
    "semver": "7.8.5",
    "string-width": "8.3.0",
    "wrap-ansi": "10.0.2",
    "ws": "8.21.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/theme-one-dark": "6.1.3",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "codemirror": "6.0.2",
    "dompurify": "3.4.16",
    "js-tiktoken": "1.0.21",
    "lucide-react": "1.48.0",
    "mermaid": "12.0.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "swr": "2.5.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
