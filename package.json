{
  "name": "raw-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "raw": "./dist/raw.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples/tools",
    "examples/skills",
    "examples/agents",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/test.mjs",
    "test:phase": "node scripts/test-phase.mjs",
    "test:overhead": "node --import tsx scripts/overhead.mjs",
    "test:package": "npm run build && node --import tsx --test tests/package.test.ts tests/package-agent.test.ts",
    "build": "tsup && tsup --config tsup.tools.config.ts && node scripts/copy-tool-manifests.mjs && node scripts/build-tool-examples.mjs && node scripts/copy-bundled-skills.mjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@anthropic-ai/sdk": "0.128.0",
    "@google/genai": "2.24.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsonc-parser": "3.3.1",
    "openai": "7.23.0",
    "re2js": "2.8.6",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "js-tiktoken": "1.0.21",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
