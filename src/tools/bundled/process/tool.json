{
  "api_version": 2,
  "id": "process",
  "version": "1.0.0",
  "name": "process",
  "description": "Manage session background Bash processes with action start/list/status/output/stop. Start requires command; optional cwd is relative to the session, label, env_refs and timeout_ms. Returns opaque ID after spawning, without readiness claim. Acknowledged jobs survive turns; stop or host shutdown ends managed process groups. Other actions use IDs, never PIDs. Output has bounded pages, absolute byte cursors and dropped/truncated metadata; inspect state and exitCode. Limits: 8 live per session, 32 per host, 100 terminal records, 1 MiB recent output per job. macOS/Linux background execution only; missing supervisor or unsupported platform fails promptly. Lost host jobs are not adopted or restarted. Process policy is separate from Bash.",
  "entry": "./index.mjs",
  "input_schema": {
    "type": "object",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "const": "start"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "env_refs": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "action",
          "command"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "const": "list"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "const": "status"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "action",
          "id"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "const": "output"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "cursor": {
            "type": "integer",
            "minimum": 0
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          }
        },
        "required": [
          "action",
          "id"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "const": "stop"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "action",
          "id"
        ],
        "additionalProperties": false
      }
    ]
  }
}
